[ext_resource type="AudioStream" path="res://assets/audio/sfx/vcr_insert.wav" id="9_whirr"]

[sub_resource type="ShaderMaterial" id="Material_vhs"]
shader = ExtResource("6_vhs")
shader_parameter/noise_amount = 0.09
shader_parameter/scanline_amount = 0.14

[sub_resource type="StyleBoxFlat" id="Style_osd"]
bg_color = Color(0.03, 0.09, 0.55, 0.84)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.75, 0.82, 1, 0.6)
content_margin_left = 30.0
content_margin_top = 24.0
content_margin_right = 30.0
content_margin_bottom = 24.0

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_menu")

[node name="Backdrop" type="SubViewportContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
