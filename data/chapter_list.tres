[gd_resource type="Resource" script_class="ChapterList" format=3]

[ext_resource type="Script" path="res://systems/chapters/chapter_list.gd" id="1_list"]
[ext_resource type="Script" path="res://systems/chapters/chapter_data.gd" id="2_data"]
[ext_resource type="Resource" path="res://chapters/chapter_01/chapter.tres" id="t1"]
[ext_resource type="Resource" path="res://chapters/chapter_02/chapter.tres" id="t2"]
[ext_resource type="Resource" path="res://chapters/chapter_03/chapter.tres" id="t3"]
[ext_resource type="Resource" path="res://chapters/chapter_04/chapter.tres" id="t4"]
[ext_resource type="Resource" path="res://chapters/chapter_05/chapter.tres" id="t5"]
[ext_resource type="Resource" path="res://tests/scenes/test_chapter.tres" id="dbg"]
[ext_resource type="Resource" path="res://chapters/chapter_02/chapter_wip.tres" id="t2wip"]

[resource]
script = ExtResource("1_list")
chapters = Array[ExtResource("2_data")]([ExtResource("t1"), ExtResource("t2"), ExtResource("t3"), ExtResource("t4"), ExtResource("t5")])
debug_chapters = Array[ExtResource("2_data")]([ExtResource("dbg"), ExtResource("t2wip")])
hub_scene = "res://chapters/hub/hub.tscn"
