[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/settings_menu.gd" id="1_settings"]
[ext_resource type="Theme" path="res://ui/themes/vcr_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://ui/menus/menu_list.gd" id="3_list"]

[node name="SettingsMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_settings")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.75)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -400.0
offset_top = -268.0
offset_right = 400.0
offset_bottom = 268.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "SETTINGS"

[node name="Rows" type="GridContainer" parent="Panel/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 6
columns = 3

[node name="BackList" type="VBoxContainer" parent="Panel/VBox"]
layout_mode = 2
