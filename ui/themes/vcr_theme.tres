[gd_resource type="Theme" format=3]

[ext_resource type="FontVariation" path="res://assets/fonts/ui.tres" id="1_ui"]
[ext_resource type="FontVariation" path="res://assets/fonts/ui_bold.tres" id="2_bold"]
[ext_resource type="FontVariation" path="res://assets/fonts/vcr.tres" id="3_vcr"]

[sub_resource type="StyleBoxFlat" id="Button_normal"]
bg_color = Color(0, 0, 0, 0)
content_margin_left = 14.0
content_margin_top = 4.0
content_margin_right = 14.0
content_margin_bottom = 4.0

[sub_resource type="StyleBoxFlat" id="Button_selected"]
bg_color = Color(0.9, 0.9, 0.88, 1)
content_margin_left = 14.0
content_margin_top = 4.0
content_margin_right = 14.0
content_margin_bottom = 4.0

[sub_resource type="StyleBoxFlat" id="Slider_track"]
bg_color = Color(0.5, 0.5, 0.5, 0.6)
content_margin_top = 2.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxFlat" id="Slider_fill"]
bg_color = Color(0.9, 0.9, 0.88, 1)
content_margin_top = 2.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxFlat" id="Slider_fill_focus"]
bg_color = Color(1, 1, 1, 1)
content_margin_top = 3.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="Focus_outline"]
bg_color = Color(0, 0, 0, 0)
draw_center = false
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.9, 0.9, 0.88, 0.9)
expand_margin_left = 4.0
expand_margin_top = 4.0
expand_margin_right = 4.0
expand_margin_bottom = 4.0

[sub_resource type="StyleBoxFlat" id="Panel_dark"]
bg_color = Color(0.02, 0.02, 0.03, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.9, 0.9, 0.88, 0.5)
content_margin_left = 28.0
content_margin_top = 24.0
content_margin_right = 28.0
content_margin_bottom = 24.0

[sub_resource type="StyleBoxFlat" id="Tab_selected"]
bg_color = Color(0.9, 0.9, 0.88, 1)
content_margin_left = 12.0
content_margin_top = 2.0
content_margin_right = 12.0
content_margin_bottom = 2.0

[resource]
resource_name = "UNLABELED shared UI theme"
default_font = ExtResource("1_ui")
default_font_size = 24
Button/font_sizes/font_size = 30
Button/fonts/font = ExtResource("3_vcr")
VCRLabel/base_type = &"Label"
VCRLabel/font_sizes/font_size = 30
VCRLabel/fonts/font = ExtResource("3_vcr")
RichTextLabel/fonts/normal_font = ExtResource("1_ui")
RichTextLabel/fonts/bold_font = ExtResource("2_bold")
RichTextLabel/colors/default_color = Color(0.92, 0.92, 0.9, 1)
TabBar/fonts/font = ExtResource("3_vcr")
TabBar/font_sizes/font_size = 28
TabBar/colors/font_selected_color = Color(0.03, 0.03, 0.06, 1)
TabBar/colors/font_unselected_color = Color(0.7, 0.7, 0.68, 1)
TabBar/colors/font_hovered_color = Color(1, 1, 1, 1)
TabBar/styles/tab_selected = SubResource("Tab_selected")
TabBar/styles/tab_unselected = SubResource("Button_normal")
TabBar/styles/tab_hovered = SubResource("Button_normal")
TabBar/styles/tab_focus = SubResource("Focus_outline")
Button/colors/font_color = Color(0.9, 0.9, 0.88, 1)
Button/colors/font_disabled_color = Color(0.45, 0.45, 0.45, 1)
Button/colors/font_focus_color = Color(0.03, 0.03, 0.06, 1)
Button/colors/font_hover_color = Color(0.03, 0.03, 0.06, 1)
Button/colors/font_hover_pressed_color = Color(0.03, 0.03, 0.06, 1)
Button/colors/font_pressed_color = Color(0.03, 0.03, 0.06, 1)
Button/styles/disabled = SubResource("Button_normal")
Button/styles/focus = SubResource("Button_selected")
Button/styles/hover = SubResource("Button_selected")
Button/styles/hover_pressed = SubResource("Button_selected")
Button/styles/normal = SubResource("Button_normal")
Button/styles/pressed = SubResource("Button_selected")
CheckButton/colors/font_color = Color(0.9, 0.9, 0.88, 1)
CheckButton/colors/font_focus_color = Color(1, 1, 1, 1)
CheckButton/colors/font_hover_color = Color(1, 1, 1, 1)
CheckButton/styles/focus = SubResource("Focus_outline")
CheckButton/styles/hover = SubResource("Button_normal")
CheckButton/styles/normal = SubResource("Button_normal")
CheckButton/styles/pressed = SubResource("Button_normal")
HSlider/styles/focus = SubResource("Focus_outline")
HSlider/styles/grabber_area = SubResource("Slider_fill")
HSlider/styles/grabber_area_highlight = SubResource("Slider_fill_focus")
HSlider/styles/slider = SubResource("Slider_track")
Label/colors/font_color = Color(0.9, 0.9, 0.88, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.6)
Label/constants/shadow_offset_x = 2
Label/constants/shadow_offset_y = 2
PanelContainer/styles/panel = SubResource("Panel_dark")
