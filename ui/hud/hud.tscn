[node name="Prompt" type="Label" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = 22.0
offset_right = 300.0
offset_bottom = 48.0
mouse_filter = 2
theme_override_colors/font_color = Color(0.92, 0.92, 0.92, 1)
