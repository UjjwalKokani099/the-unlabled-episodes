[ext_resource type="Script" path="res://scripts/ui/objective_panel.gd" id="3_objectives"]
[ext_resource type="PackedScene" path="res://ui/menus/pause_menu.tscn" id="4_pause"]
[ext_resource type="Script" path="res://scripts/ui/note_view.gd" id="5_note"]
[ext_resource type="PackedScene" path="res://ui/hud/subtitles.tscn" id="6_subs"]
[ext_resource type="Script" path="res://scripts/ui/inspect_view.gd" id="7_inspect"]

[sub_resource type="StyleBoxFlat" id="Style_paper"]
bg_color = Color(0.93, 0.9, 0.8, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.6, 0.55, 0.45, 1)
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 12

[sub_resource type="SystemFont" id="Font_print"]
font_names = PackedStringArray("Courier New", "Consolas", "Nirmala UI")

[node name="HUD" type="CanvasLayer"]
layer = 10
script = ExtResource("1_hud")

[node name="Crosshair" type="Control" parent="."]
