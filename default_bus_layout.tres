[gd_resource type="AudioBusLayout" format=3]

[sub_resource type="AudioEffectReverb" id="Reverb_space"]
resource_name = "Space"
predelay_msec = 20.0
room_size = 0.3
damping = 0.7
spread = 0.6
hipass = 0.15
dry = 1.0
wet = 0.0

[sub_resource type="AudioEffectLowPassFilter" id="Muffle_sfx"]
resource_name = "PauseMuffle"
cutoff_hz = 900.0

[sub_resource type="AudioEffectLowPassFilter" id="Muffle_ambience"]
resource_name = "PauseMuffle"
cutoff_hz = 900.0

[sub_resource type="AudioEffectLowPassFilter" id="Muffle_voice"]
resource_name = "PauseMuffle"
cutoff_hz = 900.0

[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
bus/2/effect/0/effect = SubResource("Reverb_space")
bus/2/effect/0/enabled = true
bus/2/effect/1/effect = SubResource("Muffle_sfx")
bus/2/effect/1/enabled = false
bus/3/name = &"Ambience"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Master"
bus/3/effect/0/effect = SubResource("Muffle_ambience")
bus/3/effect/0/enabled = false
bus/4/name = &"Voice"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = 0.0
bus/4/send = &"Master"
bus/4/effect/0/effect = SubResource("Muffle_voice")
bus/4/effect/0/enabled = false
bus/5/name = &"UI"
bus/5/solo = false
bus/5/mute = false
bus/5/bypass_fx = false
bus/5/volume_db = 0.0
bus/5/send = &"Master"
